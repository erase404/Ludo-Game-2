      <p class="text-slate-400 text-xs text-center mb-6">Select players & rule settings to start game</p>

      <form id="setup-form" onsubmit="startGame(event)" class="space-y-5">
        <!-- Mode Select -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Game Mode</label>
          <div class="grid grid-cols-3 gap-2">
