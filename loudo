  </main>

  <!-- Footer -->
  <footer class="w-full text-center py-3 text-xs text-slate-500 border-t border-slate-800/80 glass-panel">
    Crafted with <i class="fa-solid fa-heart text-red-500"></i> for interactive gameplay | Modern HTML5 Ludo
  </footer>

  <!-- Setup Game Modal -->
  <div id="setup-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
    <div class="glass-panel bg-slate-900 border border-slate-700/80 w-full max-w-md rounded-3xl p-6 shadow-2xl relative text-slate-100">
