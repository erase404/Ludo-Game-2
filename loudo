<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ludo Realm - Modern 4-Player Ludo</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    * {
      font-family: 'Outfit', sans-serif;
      user-select: none;
      -webkit-user-select: none;
    }

    /* Vibrant Glassmorphism Aesthetics */
    .glass-panel {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .dark .glass-panel {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Player Specific Colors & Glows */
    .red-theme { color: #ef4444; }
    .bg-red-custom { background-color: #ef4444; }
    .green-theme { color: #10b981; }
    .bg-green-custom { background-color: #10b981; }
    .yellow-theme { color: #f59e0b; }
    .bg-yellow-custom { background-color: #f59e0b; }
    .blue-theme { color: #3b82f6; }
    .bg-blue-custom { background-color: #3b82f6; }

    .glow-red { box-shadow: 0 0 20px rgba(239, 68, 68, 0.6); }
    .glow-green { box-shadow: 0 0 20px rgba(16, 185, 129, 0.6); }
    .glow-yellow { box-shadow: 0 0 20px rgba(245, 158, 11, 0.6); }
    .glow-blue { box-shadow: 0 0 20px rgba(59, 130, 246, 0.6); }

    /* Ludo Grid Definition */
    .ludo-grid {
      display: grid;
      grid-template-columns: repeat(15, 1fr);
      grid-template-rows: repeat(15, 1fr);
      aspect-ratio: 1 / 1;
      width: 100%;
      max-width: 620px;
    }

    .grid-cell {
      position: relative;
      border: 1px solid rgba(0, 0, 0, 0.06);
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      overflow: hidden;
    }

    /* Central Triangle Shapes */
    .center-home {
      grid-column: 7 / span 3;
      grid-row: 7 / span 3;
      position: relative;
      background: #f8fafc;
      overflow: hidden;
    }

    .triangle-red {
      position: absolute;
      left: 0; top: 0; bottom: 0; width: 50%;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
      background: #ef4444;
    }
    .triangle-green {
      position: absolute;
      top: 0; left: 0; right: 0; height: 50%;
      clip-path: polygon(0 0, 100% 0, 50% 100%);
      background: #10b981;
    }
    .triangle-yellow {
      position: absolute;
      right: 0; top: 0; bottom: 0; width: 50%;
      clip-path: polygon(100% 0, 0 50%, 100% 100%);
      background: #f59e0b;
    }
    .triangle-blue {
      position: absolute;
      bottom: 0; left: 0; right: 0; height: 50%;
      clip-path: polygon(0 100%, 100% 100%, 50% 0);
      background: #3b82f6;
    }

    /* Tokens Design */
    .pawn {
      position: absolute;
      width: 72%;
      height: 72%;
      border-radius: 50%;
      z-index: 20;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3), inset 0 2px 4px rgba(255, 255, 255, 0.6);
      border: 2px solid white;
    }

    .pawn::after {
      content: '';
      width: 38%;
      height: 38%;
      background: rgba(255, 255, 255, 0.85);
      border-radius: 50%;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.2);
    }

    .pawn-movable {
      animation: pulse-glow 0.8s infinite alternate;
      z-index: 30 !important;
    }

    @keyframes pulse-glow {
      0% { transform: scale(1); filter: drop-shadow(0 0 2px white); }
      100% { transform: scale(1.22); filter: drop-shadow(0 0 10px #ffffff); }
    }

    /* Animated 3D Dice styling */
    .dice-container {
      perspective: 600px;
    }
    
    .dice {
      width: 64px;
      height: 64px;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 1s ease-out;
      cursor: pointer;
    }

    .dice-face {
      position: absolute;
      width: 64px;
      height: 64px;
      background: linear-gradient(145deg, #ffffff, #f1f5f9);
      border-radius: 14px;
      border: 2px solid #e2e8f0;
      box-shadow: inset 0 0 8px rgba(0,0,0,0.06), 0 4px 12px rgba(0,0,0,0.1);
      display: grid;
      grid-template: repeat(3, 1fr) / repeat(3, 1fr);
      padding: 6px;
      box-sizing: border-border-box;
    }

    .dot {
      background-color: #1e293b;
      border-radius: 50%;
      margin: auto;
      width: 10px;
      height: 10px;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.4);
    }

    /* Dice Faces positions */
    .face-1 { transform: translateZ(32px); }
    .face-2 { transform: rotateY(180deg) translateZ(32px); }
    .face-3 { transform: rotateY(90deg) translateZ(32px); }
    .face-4 { transform: rotateY(-90deg) translateZ(32px); }
    .face-5 { transform: rotateX(90deg) translateZ(32px); }
    .face-6 { transform: rotateX(-90deg) translateZ(32px); }

    /* Dot configurations */
    .face-1 .dot { grid-area: 2 / 2; background-color: #ef4444; width: 14px; height: 14px; }
    .face-2 .dot:nth-child(1) { grid-area: 1 / 1; }
    .face-2 .dot:nth-child(2) { grid-area: 3 / 3; }
    .face-3 .dot:nth-child(1) { grid-area: 1 / 1; }
    .face-3 .dot:nth-child(2) { grid-area: 2 / 2; }
    .face-3 .dot:nth-child(3) { grid-area: 3 / 3; }
    .face-4 .dot:nth-child(1) { grid-area: 1 / 1; }
    .face-4 .dot:nth-child(2) { grid-area: 1 / 3; }
    .face-4 .dot:nth-child(3) { grid-area: 3 / 1; }
    .face-4 .dot:nth-child(4) { grid-area: 3 / 3; }
    .face-5 .dot:nth-child(1) { grid-area: 1 / 1; }
    .face-5 .dot:nth-child(2) { grid-area: 1 / 3; }
    .face-5 .dot:nth-child(3) { grid-area: 2 / 2; }
    .face-5 .dot:nth-child(4) { grid-area: 3 / 1; }
    .face-5 .dot:nth-child(5) { grid-area: 3 / 3; }
    .face-6 .dot:nth-child(1) { grid-area: 1 / 1; }
    .face-6 .dot:nth-child(2) { grid-area: 1 / 3; }
    .face-6 .dot:nth-child(3) { grid-area: 2 / 1; }
    .face-6 .dot:nth-child(4) { grid-area: 2 / 3; }
    .face-6 .dot:nth-child(5) { grid-area: 3 / 1; }
    .face-6 .dot:nth-child(6) { grid-area: 3 / 3; }

    .rolling {
      animation: dice-shake 0.6s ease-in-out infinite alternate;
    }

    @keyframes dice-shake {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      100% { transform: rotateX(360deg) rotateY(360deg) rotateZ(180deg); }
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(156, 163, 175, 0.4);
      border-radius: 10px;
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between overflow-x-hidden selection:bg-indigo-500 selection:text-white">

  <!-- Header / Top Bar -->
  <header class="w-full px-6 py-4 flex items-center justify-between glass-panel border-b border-slate-800 z-40 sticky top-0">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/30">
        <i class="fa-solid fa-gamepad text-xl text-white"></i>
      </div>
      <div>
        <h1 class="text-xl font-bold bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">LUDO REALM</h1>
