          <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full">Live</span>
        </div>
        <div id="game-log" class="flex-1 overflow-y-auto space-y-2 pr-1 text-xs text-slate-300">
