    </div>

    <!-- Center: Ludo Board -->
    <div class="lg:col-span-6 flex justify-center items-center order-1 lg:order-2">
      <div class="glass-panel p-3 md:p-5 rounded-3xl shadow-2xl border border-slate-700/50 bg-slate-800/80 w-full max-w-[620px]">
        <div id="ludo-board" class="ludo-grid bg-white rounded-2xl shadow-inner border border-slate-300 relative overflow-hidden">
